{
  "name": "agenda-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "migrate": "node --env-file-if-exists=.env.local --import tsx lib/migrate.ts",
    "access:generate": "node --env-file-if-exists=.env.local --import tsx lib/generate-access.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
